# MAINNET_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# Server-side only — used by the bundler to pay deployment fees.
BUNDLER_SECRET=""

# ──────────────────────────────────────────────────────────────────────────────
# Sign demo app (/dev/sign-demo)
